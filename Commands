# Crear la Imagen

docker build -t archlinux .

# Contenedor con las mismas interfaces en red que el dipositivo (para auditorias en red)
docker run -it \
  --name hackarch-2 \
  --network host \
  --privileged \
  --shm-size=4g \
  --cap-add=ALL \
  --ipc=host \
  -v /run/user/1000:/run/user/1000 \
  -v /tmp/.X11-unix:/tmp/.X11-unix \
  -v /dev/dri:/dev/dri \
  archlinux \
  /bin/zsh

==============Alias a usar Zsh====================
# todo en la maquina host (No docker)
# instalar xorg-xhost
# ejecutar: xhost +local -> esto es necesario siempre que vamos a usarlo
# agregarlo si se requiere simpre al inicio de session o a los alias para que se
# ejecute o prenda solo cuando vamos a usar esto y no siempre


pentest() {
    echo "[+] Iniciando máquina hackarch-2..."
    docker start hackarch-2 >/dev/null
    xhost +local: &>/dev/null

    echo "[+] Desplegando terminal maestra en GNOME (Forzando X11)..."
    nohup docker exec -d \
        -e DISPLAY=$DISPLAY \
        -e XDG_RUNTIME_DIR=/run/user/1000 \
        -e QT_QPA_PLATFORM=xcb \
        -e GDK_BACKEND=x11 \
        -u stark \
        hackarch-2 kitty >/dev/null 2>&1 &
    
    disown
    echo "[+] Entorno hackarch-2 listo y terminal desplegada."
}

pentest-stop() {
    echo "[-] Deteniendo máquina hackarch-2..."
    docker stop hackarch-2 >/dev/null
    echo "[-] hackarch-2 se ha detenido correctamente."
}
