# Crear la Imagen

docker build -t archlinux .

# Configurar interfaz de red privada vinculada al bridge personal (crea la red ejecutar una sola vez si no la tenemos )
# verificar con docker network ls

docker network create \
  --driver=bridge \
  --subnet=10.10.10.0/24 \
  --gateway=10.10.10.1 \
  -o "com.docker.network.bridge.name"="br-machines" \
  net-machines

# Crear el contenedor a la red privada
docker run -it \
  --name hackarch-1 \
  --network net-machines \
  --hostname archlinux \
  --privileged \
  --ipc=host \
  -v /run/user/1000:/run/user/1000 \
  -v /tmp/.X11-unix:/tmp/.X11-unix \
  -v /dev/dri:/dev/dri \
  archlinux


# Contenedor con las mismas interfaces en red que el dipositivo (para auditorias en red)
docker run -it \
  --name hackarch-2 \
  --network host \
  --privileged \
  --cap-add=ALL \
  --ipc=host \
  -v /run/user/1000:/run/user/1000 \
  -v /tmp/.X11-unix:/tmp/.X11-unix \
  -v /dev/dri:/dev/dri \
  archlinux \
  /bin/zsh

