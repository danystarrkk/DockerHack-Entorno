#hackarch-1:
function hackvm
    echo "[+] Iniciando máquina hackarch-1..."
    docker start hackarch-1 >/dev/null
    
    echo "[+] Desplegando terminal maestra en Niri..."
    nohup docker exec -d \
        -e WAYLAND_DISPLAY=$WAYLAND_DISPLAY \
        -e XDG_RUNTIME_DIR=/run/user/1000 \
        -e QT_QPA_PLATFORM=wayland \
        -e GDK_BACKEND=wayland \
        -u stark \
        hackarch-1 kitty >/dev/null 2>&1 &
    
    disown
    echo "[+] Entorno hackarch-1 listo y terminal desplegada."
end

function vmhack-stop
    echo "[-] Deteniendo máquina hackarch-1..."
    docker stop hackarch-1 >/dev/null
    echo "[-] hackarch-1 se ha detenido correctamente."
end


