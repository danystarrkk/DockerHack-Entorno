# Crear la Imagen
docker build --network=host -t kali-pentest .

docker run -it -d \
  --name kali-box \
  --network host \
  --privileged \
  --shm-size=4g \
  --cap-add=ALL \
  --ipc=host \
  -v /run/user/1000:/run/user/1000 \
  -v /tmp/.X11-unix:/tmp/.X11-unix \
  -v /dev/dri:/dev/dri \
  -e HOSTNAME=kali \
  -e DISPLAY=$DISPLAY \
  -e WAYLAND_DISPLAY=$WAYLAND_DISPLAY \
  -e XDG_RUNTIME_DIR=/run/user/1000 \
  kali-pentest \
  /bin/zsh

==============Alias a usar Zsh====================
# todo en la maquina host (No docker)
# instalar xorg-xhost
# ejecutar: xhost +local -> esto es necesario siempre que vamos a usarlo
# agregarlo si se requiere simpre al inicio de session o a los alias para que se
# ejecute o prenda solo cuando vamos a usar esto y no siempre

pentest() {
    echo "[+] Iniciando máquina kali-box..."
    docker start kali-box >/dev/null
    xhost +local: &>/dev/null

    echo "[+] Desplegando terminal maestra en GNOME (Forzando X11)..."
    nohup docker exec -d \
        -e DISPLAY=$DISPLAY \
        -e XDG_RUNTIME_DIR=/run/user/1000 \
        -e QT_QPA_PLATFORM=xcb \
        -e GDK_BACKEND=x11 \
        -u stark \
        kali-box kitty >/dev/null 2>&1 &
    
    disown
    echo "[+] Entorno kali-box listo y terminal desplegada."
}

pentest-stop() {
    echo "[-] Deteniendo máquina kali-box..."
    docker stop kali-box >/dev/null
    echo "[-] kali-box se ha detenido correctamente."
}
