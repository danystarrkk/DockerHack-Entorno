# Construir imagen cambiando el nombre de usuario y el shell
docker build \
  --build-arg USERNAME=stark \
  --build-arg USER_SHELL=/bin/zsh \
  -t kali-pentest .

# Ejecución inicial (Nótese las comillas simples en el unshare)
docker run -it \
  --name kali-box \
  --network host \
  --privileged \
  --add-host kali:127.0.0.1 \
  -v /run/user/1000:/run/user/1000 \
  -v /tmp/.X11-unix:/tmp/.X11-unix \
  -v /dev/dri:/dev/dri \
  -v /run/systemd/resolve:/run/systemd/resolve:ro \
  -v /var/run/NetworkManager:/var/run/NetworkManager:ro \
  -v /dev/bus/usb:/dev/bus/usb \
  -e DISPLAY=$DISPLAY \
  -e WAYLAND_DISPLAY=$WAYLAND_DISPLAY \
  -e XDG_RUNTIME_DIR=/run/user/1000 \
  kali-pentest \
  bash -c 'sudo unshare --uts bash -c "hostname kali && exec su - $RUNTIME_USER -s $RUNTIME_SHELL"'

# ==============================================================================
# ENTORNO DE PENTESTING DOCKERIZADO (KALI-BOX)
# ==============================================================================

export PENTEST_CONTAINER="kali-box"
export PENTEST_USER="stark"
export PENTEST_HOSTNAME="kali"

pentest() {
    echo "[+] Inicializando entorno de hacking..."
    
    xhost +local: &>/dev/null

    if ! docker ps --format '{{.Names}}' | grep -Eq "^${PENTEST_CONTAINER}\$"; then
        echo "[+] Levantando contenedor ${PENTEST_CONTAINER}..."
        docker start ${PENTEST_CONTAINER} >/dev/null
        sleep 1 
    else
        echo "[*] El contenedor ya se encuentra en ejecución."
    fi

    echo "[+] Desplegando terminal gráfica (Kitty)..."
    
    docker exec -d \
        -e DISPLAY=$DISPLAY \
        -e XDG_RUNTIME_DIR=/run/user/1000 \
        -e QT_QPA_PLATFORM=xcb \
        -e GDK_BACKEND=x11 \
        -e LIBGL_ALWAYS_SOFTWARE=0 \
        -e KITTY_DISABLE_WAYLAND=1 \
        -e MOZ_DISABLE_CONTENT_SANDBOX=1 \
        -e GTK_USE_PORTAL=0 \
        -e GLYCIN_NO_SANDBOX=1 \
        -e GSK_RENDERER=gl \
        -u ${PENTEST_USER} \
        ${PENTEST_CONTAINER} \
        sudo -E unshare --uts sh -c "hostname ${PENTEST_HOSTNAME} && umount /etc/resolv.conf 2>/dev/null; ln -sf /var/run/NetworkManager/resolv.conf /etc/resolv.conf 2>/dev/null; chmod a+rw /dev/dri/* 2>/dev/null; exec sudo -E -u ${PENTEST_USER} kitty > /tmp/kitty_error.log 2>&1"
    
    echo "[+] Entorno listo. Terminal maestra desplegada con éxito."
}

pentest-stop() {
    echo "[-] Deteniendo máquina ${PENTEST_CONTAINER}..."
    docker stop ${PENTEST_CONTAINER} >/dev/null
    echo "[-] Contenedor detenido y recursos liberados."
}
